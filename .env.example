# Copy to .env before deploying. The SQLite database is stored in the Docker volume.
DOSEKEEP_DATABASE_URL=sqlite:////data/dosekeep.db
DOSEKEEP_ALLOWED_ORIGINS=http://localhost:8080
DOSEKEEP_PORT=8080
# Public HTTPS address used for time-limited reminder action links.
DOSEKEEP_PUBLIC_URL=https://dosekeep.example.com

# Optional. If left blank, DoseKeep generates a stable key inside its
# persistent Docker volume on first start. An operator-managed key can be set
# here instead.
DOSEKEEP_MASTER_KEY=
