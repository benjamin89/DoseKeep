# Copy to .env before deploying. The SQLite database is stored in the Docker volume.
DOSEKEEP_DATABASE_URL=sqlite:////data/dosekeep.db
DOSEKEEP_ALLOWED_ORIGINS=http://localhost:8080
DOSEKEEP_PORT=8080

# A long random deployment secret. Keep it stable: it protects account
# sessions and encrypts each user's optional MediKeep connection settings.
DOSEKEEP_MASTER_KEY=replace-with-a-long-random-secret
