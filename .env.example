# Copy to .env before deploying. The SQLite database is stored in the Docker volume.
DOSEKEEP_DATABASE_URL=sqlite:////data/dosekeep.db
DOSEKEEP_ALLOWED_ORIGINS=http://localhost:8080
DOSEKEEP_PORT=8080

# Optional: read-only MediKeep import/linking. Use a bearer/API token OR a
# MediKeep username/password; these values belong in Portainer secrets/env,
# never in Git.
DOSEKEEP_MEDIKEEP_URL=http://192.168.5.230:8885/api/v1
DOSEKEEP_MEDIKEEP_TOKEN=
DOSEKEEP_MEDIKEEP_USERNAME=
DOSEKEEP_MEDIKEEP_PASSWORD=
DOSEKEEP_MEDIKEEP_PATIENT_ID=1
